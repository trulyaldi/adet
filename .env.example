# Copy to .env and fill in from Supabase Dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key
# Quest Mode kill switch (default on). Set to false to hide the Quest tab and its session hooks.
EXPO_PUBLIC_QUEST_ENABLED=true
# Projects as realms (default off): each project owns a realm on the Overworld. Needs Quest Mode.
EXPO_PUBLIC_PROJECT_REALMS=false
# Optional AI Sage (Supabase Edge Function `sage`, see supabase/functions/sage/README.md).
# The functions base URL; the app appends /sage/suggest or /sage/recap. AI stays off until enabled at the Scribe.
EXPO_PUBLIC_SAGE_URL=
# e.g. EXPO_PUBLIC_SAGE_URL=https://your-project-ref.supabase.co/functions/v1
# Desktop layout kill switch (default on). Set to false to keep the phone layout on wide web windows.
EXPO_PUBLIC_DESKTOP=true
